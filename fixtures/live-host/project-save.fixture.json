{
  "schemaVersion": 1,
  "fixtureId": "project-save",
  "description": "Open a repository-owned Premiere fixture copy, save it once, verify it, and reopen a pristine copy.",
  "project": {
    "strategy": "generated_empty",
    "relativeName": "project-save.prproj"
  },
  "mutation": {
    "actionId": "project.save",
    "args": {}
  },
  "verification": {
    "beforeActionId": "project.inspect",
    "afterActionId": "project.inspect",
    "requireVerifiedHostResult": true
  },
  "restore": {
    "strategy": "pristine_copy_reopen",
    "verifySourceDigest": true,
    "verifyProjectStateDigest": true
  }
}
