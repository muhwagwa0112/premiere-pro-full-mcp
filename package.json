{
  "name": "premiere-pro-full-mcp",
  "version": "1.0.1",
  "private": true,
  "description": "Local-first MCP server for Adobe Premiere Pro with 353 flat tools over a single persistent CEP WebSocket bridge.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "premiere-pro-full-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "vendor",
    "cep-plugin",
    "scripts",
    "README.md",
    "REBUILD-PLAN.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build && node scripts/smoke.mjs && node scripts/_e2e-bridge.mjs && node scripts/_syntax-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@adobe/premierepro": "26.3.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhwagwa0112/premiere-pro-full-mcp.git"
  },
  "homepage": "https://github.com/muhwagwa0112/premiere-pro-full-mcp#readme",
  "bugs": {
    "url": "https://github.com/muhwagwa0112/premiere-pro-full-mcp/issues"
  }
}
