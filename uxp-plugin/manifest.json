{
  "manifestVersion": 5,
  "id": "com.local.ppmcp.uxp.2026",
  "name": "Premiere MCP 2026 Bridge",
  "version": "0.2.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.3.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "premiereMcp2026Panel",
      "label": { "default": "Premiere MCP 2026" },
      "minimumSize": { "width": 320, "height": 260 },
      "preferredDockedSize": { "width": 380, "height": 460 },
      "preferredFloatingSize": { "width": 420, "height": 500 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["ws://localhost/"] }
  }
}
