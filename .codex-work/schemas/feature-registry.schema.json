{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premiere MCP Feature Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "featureId",
    "domain",
    "title",
    "status",
    "backends",
    "risk",
    "preconditions",
    "verification"
  ],
  "properties": {
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "domain": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "VERIFIED_AUTOMATED",
        "VERIFIED_READ_ONLY",
        "SUPPORTED_CONTEXTUAL",
        "PREVIEW_ONLY",
        "UI_ADAPTER_REQUIRED",
        "EXTERNAL_SERVICE_REQUIRED",
        "ENTITLEMENT_BLOCKED",
        "THIRD_PARTY_DEPENDENT",
        "MANUAL_ONLY",
        "BLOCKED_BY_HOST_VERSION",
        "UNVERIFIED",
        "UNSUPPORTED"
      ]
    },
    "backends": {
      "type": "array",
      "items": {
        "enum": [
          "local",
          "uxp",
          "cep",
          "qe",
          "ui",
          "native",
          "service"
        ]
      }
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "minimumPremiereVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "maximumPremiereVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixture": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
