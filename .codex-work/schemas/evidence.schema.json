{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premiere MCP Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "featureId",
    "backend",
    "hostVersion",
    "apiFingerprint",
    "fixtureDigest",
    "planHash",
    "outcome",
    "timestamp"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "featureId": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "hostVersion": {
      "type": "string"
    },
    "apiFingerprint": {
      "type": "string"
    },
    "fixtureDigest": {
      "type": "string"
    },
    "planHash": {
      "type": "string"
    },
    "beforeStateDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "afterStateDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "verified",
        "failed",
        "outcome_unknown",
        "not_run"
      ]
    },
    "rollbackOutcome": {
      "enum": [
        "verified",
        "failed",
        "not_applicable",
        "not_run"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
