{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premiere MCP Feature Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["featureId", "domain", "title", "status", "backends", "risk", "minimumPremiereVersion", "maximumPremiereVersion", "preconditions", "verification", "fixture", "limitations"],
  "properties": {
    "featureId": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "domain": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["VERIFIED_AUTOMATED", "VERIFIED_READ_ONLY", "SUPPORTED_CONTEXTUAL", "PREVIEW_ONLY", "UI_ADAPTER_REQUIRED", "EXTERNAL_SERVICE_REQUIRED", "ENTITLEMENT_BLOCKED", "THIRD_PARTY_DEPENDENT", "MANUAL_ONLY", "BLOCKED_BY_HOST_VERSION", "UNVERIFIED", "UNSUPPORTED"] },
    "backends": { "type": "array", "items": { "enum": ["local", "uxp", "cep", "qe", "ui", "native", "service"] }, "uniqueItems": true },
    "risk": { "enum": ["R0", "R1", "R2", "R3"] },
    "minimumPremiereVersion": { "type": ["string", "null"] },
    "maximumPremiereVersion": { "type": ["string", "null"] },
    "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "fixture": { "type": ["string", "null"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
