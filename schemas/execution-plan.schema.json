{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/premiere-mcp/execution-plan.schema.json",
  "title": "Premiere MCP Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "operationId", "jobId", "actionId", "backend", "hostVersion", "hostSessionId", "capabilityFingerprint", "risk", "normalizedRequestDigest", "effectiveRequestDigest", "approvedRootDigests", "expectedStateToken", "preconditions", "verification", "checkpointRequired", "planHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "format": "uuid" },
    "jobId": { "type": ["string", "null"], "format": "uuid" },
    "actionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "backend": { "enum": ["local", "uxp", "cep", "qe", "ui"] },
    "hostVersion": { "type": ["string", "null"] },
    "hostSessionId": { "type": ["string", "null"] },
    "capabilityFingerprint": { "type": ["string", "null"] },
    "risk": { "enum": ["R0", "R1", "R2", "R3"] },
    "normalizedRequestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "effectiveRequestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approvedRootDigests": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
    "expectedStateToken": { "type": ["string", "null"] },
    "preconditions": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
    "verification": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1 } },
    "checkpointRequired": { "type": "boolean" },
    "planHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
